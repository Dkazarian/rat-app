# Server-only Upstash Redis configuration. Never prefix these with NEXT_PUBLIC_.
KV_REST_API_URL=https://your-upstash-database.upstash.io
KV_REST_API_TOKEN=replace-with-a-development-token
# Vercel may generate REDIS_KV_REST_API_URL and REDIS_KV_REST_API_TOKEN
# instead. The server accepts those aliases when the canonical names are absent.

# Use a different prefix for development, test, and production.
RATAPP_REDIS_KEY_PREFIX=ratapp:development
RATAPP_SESSION_TTL_SECONDS=172800
RATAPP_MAX_EXPENSES_PER_SESSION=100
